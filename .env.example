# Discord Bot Environment Configuration
# All values can be injected through parameters  

# ---------------------
# Required values
# ---------------------

# Discord Bot Token
DISCORD_TOKEN=<discord-bot-token>

# Discord Guild ID for command sync
DISCORD_GUILD_ID=<discord-guild-id>

# Comma-separated list of Discord roles allowed to use restricted commands
DISCORD_ALLOWED_ROLES=<allowed-role-ids> 

# GitHub Token for API access
GITHUB_TOKEN=<github-access-token>

# GitHub Repository for API access
GITHUB_REPO=<github-repo>

# ---------------------
# Optional values
# ---------------------

# GitHub Project number (Projects v2) - Not node ID
GITHUB_PROJECT_ID=<github-project-id>

# Comma-separated list of challenge categories (optional)
CATEGORIES=web,forensics,rev,crypto,pwn,boot2root,osint,misc,blockchain,beginner,mobile # Comma-separated list of categories used in your CTF

# Comma-separated list of challenge difficulties (optional)
DIFFICULTIES=beginner,easy,medium,hard,very-hard,insane

# Comma-separated list of challenge status options (optional)
STATUS=Idea,Todo,In Progress,In Review,Change Requested,Done,Verified,Skipped

# Milestone name for created issues (optional)
MILESTONE="<milestone>"

# Project status value considered "awaiting review" (optional)
REVIEW_STATUS=In Review

# Maximum number of challenges shown by the /challenge reviews command (optional)
REVIEW_LIMIT=10
